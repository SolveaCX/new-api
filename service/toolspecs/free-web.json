  {
    "id": "web.fx.rates",
    "name": "Foreign Exchange Rates",
    "provider": "frankfurter",
    "mode": "native",
    "categories": ["finance", "reference"],
    "description": "Current or historical ECB reference exchange rates between any two currencies.",
    "keywords": ["fx", "exchange rate", "currency", "usd", "eur", "conversion"],
    "input": {
      "type": "object",
      "properties": {
        "from": { "type": "string", "description": "Base currency code.", "default": "USD", "example": "USD" },
        "to": { "type": "string", "description": "Comma-separated target codes.", "default": "EUR,GBP,JPY,CNY" },
        "date": { "type": "string", "description": "YYYY-MM-DD for a historical rate. Omit for latest." }
      },
      "required": ["from"]
    },
    "pricing": { "model": "free", "amount": 0, "cost": 0 },
    "adapter": {
      "kind": "http",
      "method": "GET",
      "url": "https://api.frankfurter.app/latest",
      "auth": { "type": "none" },
      "query": { "from": "{{from}}", "to": "{{to}}" }
    }
  },
  {
    "id": "web.geocode.search",
    "name": "Geocode an Address",
    "provider": "openstreetmap",
    "mode": "native",
    "categories": ["location", "reference"],
    "description": "Convert a place name or address into coordinates, with the matched administrative hierarchy and bounding box.",
    "keywords": ["geocode", "address", "latitude", "longitude", "maps", "location"],
    "input": {
      "type": "object",
      "properties": {
        "q": { "type": "string", "example": "160 E Tasman Dr, San Jose, CA" },
        "limit": { "type": "number", "default": 5 }
      },
      "required": ["q"]
    },
    "pricing": { "model": "free", "amount": 0, "cost": 0 },
    "adapter": {
      "kind": "http",
      "method": "GET",
      "url": "https://nominatim.openstreetmap.org/search",
      "auth": { "type": "none" },
      "headers": { "user-agent": "voc-tools-hub/0.1 (support@voc.ai)" },
      "query": { "q": "{{q}}", "format": "json", "limit": "{{limit}}", "addressdetails": "1" }
    }
  },
  {
    "id": "web.weather.forecast",
    "name": "Weather Forecast by Coordinates",
    "provider": "openmeteo",
    "mode": "native",
    "categories": ["location", "reference"],
    "description": "Current conditions and daily forecast for a latitude/longitude. Useful for seasonality and demand analysis.",
    "keywords": ["weather", "forecast", "temperature", "climate", "seasonality"],
    "input": {
      "type": "object",
      "properties": {
        "latitude": { "type": "number", "example": 37.41 },
        "longitude": { "type": "number", "example": -121.94 },
        "forecast_days": { "type": "number", "default": 3 }
      },
      "required": ["latitude", "longitude"]
    },
    "pricing": { "model": "free", "amount": 0, "cost": 0 },
    "adapter": {
      "kind": "http",
      "method": "GET",
      "url": "https://api.open-meteo.com/v1/forecast",
      "auth": { "type": "none" },
      "query": {
        "latitude": "{{latitude}}",
        "longitude": "{{longitude}}",
        "forecast_days": "{{forecast_days}}",
        "current": "temperature_2m,precipitation,weather_code",
        "daily": "temperature_2m_max,temperature_2m_min,precipitation_sum"
      }
    }
  },

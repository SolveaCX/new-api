[
  {
    "id": "web.hn.search",
    "name": "Hacker News Search",
    "provider": "hackernews",
    "mode": "native",
    "categories": ["search", "social", "tech"],
    "description": "Search Hacker News stories and comments by keyword, sorted by relevance or recency. Returns title, url, points, author and comment count.",
    "keywords": ["hackernews", "ycombinator", "tech news", "startup discussion"],
    "input": {
      "type": "object",
      "properties": {
        "query": { "type": "string", "description": "Search keywords.", "example": "mcp server" },
        "tags": { "type": "string", "description": "Filter by type.", "enum": ["story", "comment", "poll", "show_hn", "ask_hn", "front_page"], "default": "story" },
        "hitsPerPage": { "type": "number", "description": "Results to return, 1-100.", "default": 20 }
      },
      "required": ["query"]
    },
    "output": { "description": "Array of hits with title, url, points, num_comments, author, created_at." },
    "pricing": { "model": "free", "amount": 0, "cost": 0 },
    "adapter": {
      "kind": "http",
      "method": "GET",
      "url": "https://hn.algolia.com/api/v1/search",
      "auth": { "type": "none" },
      "query": { "query": "{{query}}", "tags": "{{tags}}", "hitsPerPage": "{{hitsPerPage}}" },
      "resultPath": "hits"
    },
    "docsUrl": "https://hn.algolia.com/api"
  },
  {
    "id": "web.github.repo_search",
    "name": "GitHub Repository Search",
    "provider": "github",
    "mode": "native",
    "categories": ["search", "tech", "developer"],
    "description": "Search public GitHub repositories by keyword, language or stars. Returns name, description, stars, language and URL.",
    "keywords": ["github", "open source", "repository", "stars"],
    "input": {
      "type": "object",
      "properties": {
        "q": { "type": "string", "description": "GitHub search qualifiers, e.g. \"mcp server language:python stars:>100\".", "example": "model context protocol" },
        "sort": { "type": "string", "enum": ["stars", "forks", "updated"], "default": "stars" },
        "per_page": { "type": "number", "default": 20 }
      },
      "required": ["q"]
    },
    "output": { "description": "Array of repositories with full_name, description, stargazers_count, language, html_url." },
    "pricing": { "model": "free", "amount": 0, "cost": 0 },
    "adapter": {
      "kind": "http",
      "method": "GET",
      "url": "https://api.github.com/search/repositories",
      "auth": { "type": "none" },
      "headers": { "user-agent": "voc-tools-hub", "accept": "application/vnd.github+json" },
      "query": { "q": "{{q}}", "sort": "{{sort}}", "per_page": "{{per_page}}" },
      "resultPath": "items"
    },
    "docsUrl": "https://docs.github.com/rest/search"
  },
  {
    "id": "web.github.repo_info",
    "name": "GitHub Repository Detail",
    "provider": "github",
    "mode": "native",
    "categories": ["tech", "developer"],
    "description": "Full metadata for one GitHub repository: stars, forks, open issues, licence, topics, last push.",
    "keywords": ["github repo", "stars", "forks", "license"],
    "input": {
      "type": "object",
      "properties": {
        "owner": { "type": "string", "example": "anthropics" },
        "repo": { "type": "string", "example": "anthropic-sdk-python" }
      },
      "required": ["owner", "repo"]
    },
    "pricing": { "model": "free", "amount": 0, "cost": 0 },
    "adapter": {
      "kind": "http",
      "method": "GET",
      "url": "https://api.github.com/repos/{{owner}}/{{repo}}",
      "auth": { "type": "none" },
      "headers": { "user-agent": "voc-tools-hub", "accept": "application/vnd.github+json" }
    }
  },
  {
    "id": "web.wikipedia.search",
    "name": "Wikipedia Search",
    "provider": "wikipedia",
    "mode": "native",
    "categories": ["search", "reference"],
    "description": "Search English Wikipedia article titles and snippets by keyword.",
    "keywords": ["wikipedia", "encyclopedia", "reference", "definition"],
    "input": {
      "type": "object",
      "properties": {
        "srsearch": { "type": "string", "description": "Search terms.", "example": "voice of the customer" },
        "srlimit": { "type": "number", "default": 10 }
      },
      "required": ["srsearch"]
    },
    "pricing": { "model": "free", "amount": 0, "cost": 0 },
    "adapter": {
      "kind": "http",
      "method": "GET",
      "url": "https://en.wikipedia.org/w/api.php",
      "auth": { "type": "none" },
      "headers": { "user-agent": "voc-tools-hub" },
      "query": { "action": "query", "list": "search", "srsearch": "{{srsearch}}", "srlimit": "{{srlimit}}", "format": "json" },
      "resultPath": "query.search"
    }
  },
  {
    "id": "web.wikipedia.summary",

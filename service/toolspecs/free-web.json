  {
    "id": "web.crossref.works",
    "name": "Academic Paper Search (Crossref)",
    "provider": "crossref",
    "mode": "native",
    "categories": ["research", "search"],
    "description": "Search 150M+ scholarly works by title, author or keyword. Returns DOI, title, authors, journal, publication date and citation count.",
    "keywords": ["paper", "academic", "doi", "citation", "journal", "research"],
    "input": {
      "type": "object",
      "properties": {
        "query": { "type": "string", "example": "voice of the customer analytics" },
        "rows": { "type": "number", "default": 10 }
      },
      "required": ["query"]
    },
    "pricing": { "model": "free", "amount": 0, "cost": 0 },
    "adapter": {
      "kind": "http",
      "method": "GET",
      "url": "https://api.crossref.org/works",
      "auth": { "type": "none" },
      "headers": { "user-agent": "voc-tools-hub (mailto:support@voc.ai)" },
      "query": { "query": "{{query}}", "rows": "{{rows}}" },
      "resultPath": "message.items"
    }
  },
